<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>wtm-hardware</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>0.30.2</Version>
    <Company>OXOGNET OÜ</Company>
    <Authors>OXOGNET OÜ</Authors>
    <Product>RustWTM hardware provider</Product>
    <Description>An oxog.net project, maintained by OXOGNET OÜ, Estonia.</Description>
    <Copyright>MIT licensed. See LICENSE for copyright notices.</Copyright>
    <RepositoryUrl>https://github.com/rustwtm/rustwtm</RepositoryUrl>
    <PackageProjectUrl>https://rustwtm.com</PackageProjectUrl>
    <RuntimeFrameworkVersion>8.0.31</RuntimeFrameworkVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Native libraries stay next to the program, in the install folder only
         administrators can change, instead of being unpacked to a temp folder
         that, running as SYSTEM, may be C:\Windows\Temp: .NET reuses what it
         finds there, so a file planted beforehand would run as SYSTEM. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
</Project>
